generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DISABLED
}

enum RoleCode {
  ADMIN
  MENTOR
  STUDENT
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  APPROVED
  REJECTED
  WAITLISTED
  ENROLLED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  ARCHIVED
}

enum TokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum ServiceStatus {
  ACTIVE
  COMING_SOON
  DISABLED
}

enum LearningSessionStatus {
  DRAFT
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum ResourceStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum NotificationKind {
  APPLICATION
  ENROLLMENT
  SESSION
  APPOINTMENT
  RESOURCE
  ANNOUNCEMENT
  MESSAGE
  SYSTEM
}

model User {
  id                     String              @id @default(uuid()) @db.Uuid
  email                  String              @unique @db.VarChar(254)
  passwordHash           String?             @db.VarChar(255)
  emailVerifiedAt        DateTime?
  status                 AccountStatus       @default(PENDING_VERIFICATION)
  lastLoginAt            DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  deletedAt              DateTime?
  profile                Profile?
  roles                  UserRole[]
  sessions               AuthSession[]
  challenges             AuthChallenge[]
  applications           Application[]
  enrollments            Enrollment[]
  progress               LessonProgress[]
  submissions            AssignmentSubmission[]
  ownedResources         Resource[]           @relation("ResourceOwner")
  resourceAccess         ResourceAccessLog[]
  channelMemberships     ChannelMember[]
  messages               Message[]
  reactions              MessageReaction[]
  uploadedAttachments    MessageAttachment[]
  resourcePermissions    ResourcePermission[]
  hostedSessions         LearningSession[]    @relation("SessionHost")
  attendance             Attendance[]
  requestedAppointments  Appointment[]        @relation("AppointmentRequester")
  mentoredAppointments   Appointment[]        @relation("AppointmentMentor")
  availability           AvailabilitySlot[]
  mentorProfile          MentorProfile?
  notifications          Notification[]
  conversations          AstraConversation[]
  auditEvents            AuditLog[]           @relation("AuditActor")
  authoredSections       HomePageSection[]    @relation("SectionAuthor")
  updatedSections        HomePageSection[]    @relation("SectionEditor")
  contentVersions        ContentVersion[]

  @@index([status, createdAt])
  @@index([emailVerifiedAt])
}

model Profile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @db.Uuid
  displayName String   @db.VarChar(140)
  phone       String?  @db.VarChar(40)
  college     String?  @db.VarChar(180)
  year        String?  @db.VarChar(40)
  branch      String?  @db.VarChar(120)
  bio         String?  @db.VarChar(2000)
  avatarKey   String?  @db.VarChar(500)
  timezone    String   @default("Asia/Kolkata") @db.VarChar(80)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        RoleCode         @unique
  name        String           @db.VarChar(80)
  description String?          @db.VarChar(500)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(80)
  description String           @db.VarChar(300)
  createdAt   DateTime         @default(now())
  roles       RolePermission[]
}

model UserRole {
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  grantedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model AuthSession {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @db.VarChar(64)
  userId    String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model AuthChallenge {
  id        String       @id @default(uuid()) @db.Uuid
  tokenHash String       @unique @db.VarChar(64)
  userId    String       @db.Uuid
  purpose   TokenPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, expiresAt])
}

model RateLimitBucket {
  key       String   @id @db.VarChar(190)
  count     Int      @default(0)
  resetsAt  DateTime
  updatedAt DateTime @updatedAt

  @@index([resetsAt])
}

model Course {
  id          String       @id @default(uuid()) @db.Uuid
  slug        String       @unique @db.VarChar(120)
  title       String       @db.VarChar(180)
  summary     String       @db.VarChar(1000)
  description String       @db.Text
  level       String?      @db.VarChar(60)
  status      ContentStatus @default(DRAFT)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  publishedAt DateTime?
  modules     CourseModule[]
  batches     Batch[]
  applications Application[]
  enrollments Enrollment[]
  assignments Assignment[]
  resources    Resource[]

  @@index([status, publishedAt])
}

model CourseModule {
  id          String   @id @default(uuid()) @db.Uuid
  courseId    String   @db.Uuid
  title       String   @db.VarChar(180)
  description String?  @db.VarChar(1000)
  sortOrder   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]
  assignments Assignment[]

  @@unique([courseId, sortOrder])
  @@index([courseId])
}

model Lesson {
  id          String   @id @default(uuid()) @db.Uuid
  moduleId    String   @db.Uuid
  title       String   @db.VarChar(180)
  summary     String?  @db.VarChar(1000)
  content     String   @db.Text
  durationMins Int?
  sortOrder   Int
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  module      CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress    LessonProgress[]

  @@unique([moduleId, sortOrder])
  @@index([moduleId, published])
}

model Batch {
  id             String        @id @default(uuid()) @db.Uuid
  courseId       String        @db.Uuid
  slug           String        @unique @db.VarChar(120)
  title          String        @db.VarChar(180)
  description    String?       @db.VarChar(1000)
  status         ContentStatus @default(DRAFT)
  startsAt       DateTime?
  endsAt         DateTime?
  capacity       Int?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  course         Course        @relation(fields: [courseId], references: [id], onDelete: Restrict)
  applications   Application[]
  enrollments    Enrollment[]
  sessions       LearningSession[]
  resources      Resource[]

  @@index([courseId, status, startsAt])
}

model Application {
  id             String            @id @default(uuid()) @db.Uuid
  userId         String?           @db.Uuid
  courseId       String?           @db.Uuid
  batchId        String?           @db.Uuid
  fullName       String            @db.VarChar(140)
  email          String            @db.VarChar(254)
  phone          String?           @db.VarChar(40)
  college        String?           @db.VarChar(180)
  year           String?           @db.VarChar(40)
  branch         String?           @db.VarChar(120)
  skills         String?           @db.VarChar(1000)
  experience     String?           @db.VarChar(1000)
  message        String?           @db.VarChar(4000)
  status         ApplicationStatus @default(PENDING)
  source         String            @default("website") @db.VarChar(60)
  formspreeSentAt DateTime?
  reviewedAt     DateTime?
  reviewedById   String?           @db.Uuid
  reviewNote     String?           @db.VarChar(2000)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  user           User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  course         Course?           @relation(fields: [courseId], references: [id], onDelete: SetNull)
  batch          Batch?            @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([email, createdAt])
  @@index([batchId, status])
}

model Enrollment {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  courseId    String   @db.Uuid
  batchId     String   @db.Uuid
  enrolledAt  DateTime @default(now())
  completedAt DateTime?
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Restrict)
  batch       Batch    @relation(fields: [batchId], references: [id], onDelete: Restrict)
  progress    LessonProgress[]

  @@unique([userId, batchId])
  @@index([courseId, batchId])
}

model LessonProgress {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  lessonId    String   @db.Uuid
  enrollmentId String? @db.Uuid
  startedAt   DateTime @default(now())
  completedAt DateTime?
  score       Decimal? @db.Decimal(5, 2)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  enrollment  Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)

  @@unique([userId, lessonId, enrollmentId])
  @@index([enrollmentId, completedAt])
}

model Assignment {
  id          String   @id @default(uuid()) @db.Uuid
  courseId    String   @db.Uuid
  moduleId    String?  @db.Uuid
  title       String   @db.VarChar(180)
  instructions String  @db.Text
  dueAt       DateTime?
  maxScore    Int      @default(100)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module      CourseModule? @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  submissions AssignmentSubmission[]

  @@index([courseId, published])
}

model AssignmentSubmission {
  id           String   @id @default(uuid()) @db.Uuid
  assignmentId String   @db.Uuid
  userId       String   @db.Uuid
  response     String   @db.Text
  submittedAt  DateTime @default(now())
  score        Int?
  feedback     String?  @db.Text
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, userId])
  @@index([userId, submittedAt])
}

model ResourceFolder {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(180)
  parentId  String?  @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  parent    ResourceFolder? @relation("FolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  ResourceFolder[] @relation("FolderTree")
  resources Resource[]

  @@unique([parentId, name])
  @@index([parentId])
}

model Resource {
  id          String         @id @default(uuid()) @db.Uuid
  folderId    String?        @db.Uuid
  ownerId     String         @db.Uuid
  title       String         @db.VarChar(180)
  description String?        @db.VarChar(1000)
  storageKey  String         @unique @db.VarChar(500)
  originalName String        @db.VarChar(255)
  mimeType    String         @db.VarChar(160)
  sizeBytes   BigInt
  checksum    String?        @db.VarChar(128)
  status      ResourceStatus @default(DRAFT)
  courseId    String?        @db.Uuid
  batchId     String?        @db.Uuid
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  archivedAt  DateTime?
  folder      ResourceFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  course      Course?       @relation(fields: [courseId], references: [id], onDelete: SetNull)
  batch       Batch?        @relation(fields: [batchId], references: [id], onDelete: SetNull)
  owner       User           @relation("ResourceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  permissions ResourcePermission[]
  accessLogs  ResourceAccessLog[]

  @@index([status, createdAt])
  @@index([courseId, batchId])
  @@index([folderId, status])
}

model ResourcePermission {
  id         String   @id @default(uuid()) @db.Uuid
  resourceId String   @db.Uuid
  userId     String?  @db.Uuid
  roleCode   RoleCode?
  canView    Boolean  @default(true)
  canDownload Boolean @default(false)
  canEdit    Boolean  @default(false)
  canDelete  Boolean  @default(false)
  createdAt  DateTime @default(now())
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([resourceId, userId, roleCode])
}

model ResourceAccessLog {
  id         String   @id @default(uuid()) @db.Uuid
  resourceId String   @db.Uuid
  userId     String   @db.Uuid
  action     String   @db.VarChar(40)
  result     String   @db.VarChar(24)
  ipHash     String?  @db.VarChar(64)
  createdAt  DateTime @default(now())
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([resourceId, createdAt])
  @@index([userId, createdAt])
}

model LearningSession {
  id          String               @id @default(uuid()) @db.Uuid
  batchId     String               @db.Uuid
  hostId      String               @db.Uuid
  title       String               @db.VarChar(180)
  description String?              @db.VarChar(2000)
  startsAt    DateTime
  endsAt      DateTime
  status      LearningSessionStatus @default(DRAFT)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  batch       Batch                @relation(fields: [batchId], references: [id], onDelete: Cascade)
  host        User                 @relation("SessionHost", fields: [hostId], references: [id], onDelete: Restrict)
  meeting     Meeting?
  attendance  Attendance[]

  @@index([batchId, startsAt, status])
  @@index([hostId, startsAt])
}

model Meeting {
  id              String         @id @default(uuid()) @db.Uuid
  sessionId       String         @unique @db.Uuid
  provider        String         @db.VarChar(40)
  providerEventId String?        @db.VarChar(255)
  joinUrl         String?        @db.VarChar(1000)
  calendarUrl     String?        @db.VarChar(1000)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  session         LearningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model Attendance {
  id        String         @id @default(uuid()) @db.Uuid
  sessionId String         @db.Uuid
  userId    String         @db.Uuid
  joinedAt  DateTime?
  leftAt    DateTime?
  source    String         @default("manual") @db.VarChar(40)
  session   LearningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([userId, joinedAt])
}

model CommunityChannel {
  id          String          @id @default(uuid()) @db.Uuid
  slug        String          @unique @db.VarChar(120)
  name        String          @db.VarChar(120)
  description String?         @db.VarChar(500)
  isPrivate   Boolean         @default(false)
  archivedAt  DateTime?
  createdById String          @db.Uuid
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  members     ChannelMember[]
  messages    Message[]

  @@index([archivedAt, createdAt])
}

model ChannelMember {
  channelId String          @db.Uuid
  userId    String          @db.Uuid
  joinedAt  DateTime        @default(now())
  mutedAt   DateTime?
  channel   CommunityChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([channelId, userId])
  @@index([userId, joinedAt])
}

model Message {
  id         String           @id @default(uuid()) @db.Uuid
  channelId  String           @db.Uuid
  senderId   String           @db.Uuid
  parentId   String?          @db.Uuid
  body       String           @db.VarChar(5000)
  editedAt   DateTime?
  deletedAt  DateTime?
  createdAt  DateTime         @default(now())
  channel    CommunityChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sender     User             @relation(fields: [senderId], references: [id], onDelete: Restrict)
  parent     Message?         @relation("MessageReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies    Message[]        @relation("MessageReplies")
  reactions  MessageReaction[]
  attachments MessageAttachment[]

  @@index([channelId, createdAt])
  @@index([parentId, createdAt])
}

model MessageReaction {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @db.Uuid
  userId    String   @db.Uuid
  reaction  String   @db.VarChar(24)
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, reaction])
  @@index([messageId, createdAt])
}

model MessageAttachment {
  id           String   @id @default(uuid()) @db.Uuid
  messageId    String   @db.Uuid
  uploadedById String   @db.Uuid
  storageKey   String   @unique @db.VarChar(500)
  fileName     String   @db.VarChar(255)
  mimeType     String   @db.VarChar(160)
  sizeBytes    BigInt
  createdAt    DateTime @default(now())
  message      Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
}

model AvailabilitySlot {
  id          String   @id @default(uuid()) @db.Uuid
  mentorId    String   @db.Uuid
  startsAt    DateTime
  endsAt      DateTime
  appointmentType String @db.VarChar(80)
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  mentor      User     @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([mentorId, startsAt, isAvailable])
}

model Appointment {
  id          String            @id @default(uuid()) @db.Uuid
  requesterId String            @db.Uuid
  mentorId    String            @db.Uuid
  slotId      String?           @db.Uuid
  title       String            @db.VarChar(180)
  notes       String?           @db.VarChar(2000)
  status      AppointmentStatus @default(REQUESTED)
  startsAt    DateTime
  endsAt      DateTime
  providerEventId String?       @db.VarChar(255)
  meetUrl     String?           @db.VarChar(1000)
  cancelledAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  requester   User              @relation("AppointmentRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  mentor      User              @relation("AppointmentMentor", fields: [mentorId], references: [id], onDelete: Restrict)
  slot        AvailabilitySlot? @relation(fields: [slotId], references: [id], onDelete: SetNull)

  @@index([mentorId, startsAt, status])
  @@index([requesterId, startsAt])
}

model MentorProfile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @db.Uuid
  title       String   @db.VarChar(120)
  biography   String   @db.VarChar(3000)
  expertise   String[]
  visible     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model HomePageSection {
  id          String        @id @default(uuid()) @db.Uuid
  key         String        @unique @db.VarChar(100)
  type        String        @db.VarChar(60)
  title       String        @db.VarChar(240)
  eyebrow     String?       @db.VarChar(180)
  subtitle    String?       @db.VarChar(500)
  body        String?       @db.Text
  mediaUrl    String?       @db.VarChar(1000)
  ctaText     String?       @db.VarChar(100)
  ctaUrl      String?       @db.VarChar(1000)
  visible     Boolean       @default(true)
  sortOrder   Int
  status      ContentStatus @default(DRAFT)
  scheduledAt DateTime?
  publishedAt DateTime?
  theme       Json?
  animation   Json?
  createdById String?       @db.Uuid
  updatedById String?       @db.Uuid
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  createdBy   User?         @relation("SectionAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?         @relation("SectionEditor", fields: [updatedById], references: [id], onDelete: SetNull)
  versions    ContentVersion[]

  @@unique([sortOrder])
  @@index([status, visible, sortOrder])
  @@index([scheduledAt])
}

model ContentVersion {
  id          String         @id @default(uuid()) @db.Uuid
  sectionId   String         @db.Uuid
  createdById String?        @db.Uuid
  snapshot    Json
  createdAt   DateTime       @default(now())
  section     HomePageSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  createdBy   User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([sectionId, createdAt])
}

model ServiceEndpoint {
  id          String        @id @default(uuid()) @db.Uuid
  key         String        @unique @db.VarChar(80)
  name        String        @db.VarChar(120)
  description String        @db.VarChar(500)
  endpoint    String?       @db.VarChar(1000)
  ctaText     String        @db.VarChar(80)
  status      ServiceStatus @default(COMING_SOON)
  visible     Boolean       @default(true)
  sortOrder   Int           @unique
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model SiteContent {
  id          String        @id @default(uuid()) @db.Uuid
  key         String        @unique @db.VarChar(120)
  value       Json
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  updatedById String?       @db.Uuid
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, publishedAt])
}

model Quote {
  id             String        @id @default(uuid()) @db.Uuid
  quote          String        @db.VarChar(700)
  author         String?       @db.VarChar(140)
  category       String        @db.VarChar(60)
  displayLocation String       @db.VarChar(100)
  animation      Json?
  status         ContentStatus @default(DRAFT)
  sortOrder      Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, category, displayLocation])
}

model SocialLink {
  id        String   @id @default(uuid()) @db.Uuid
  platform  String   @unique @db.VarChar(60)
  url       String?  @db.VarChar(1000)
  label     String   @db.VarChar(100)
  visible   Boolean  @default(false)
  sortOrder Int      @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NavigationItem {
  id        String   @id @default(uuid()) @db.Uuid
  label     String   @db.VarChar(100)
  href      String   @db.VarChar(1000)
  visible   Boolean  @default(true)
  sortOrder Int      @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FooterContent {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique @db.VarChar(80)
  value     String   @db.VarChar(2000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Testimonial {
  id          String        @id @default(uuid()) @db.Uuid
  personName  String        @db.VarChar(140)
  role        String?       @db.VarChar(180)
  quote       String        @db.VarChar(1500)
  photoKey    String?       @db.VarChar(500)
  consentedAt DateTime?
  status      ContentStatus @default(DRAFT)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, sortOrder])
}

model Achievement {
  id          String        @id @default(uuid()) @db.Uuid
  title       String        @db.VarChar(180)
  description String        @db.VarChar(1200)
  achievedAt  DateTime?
  mediaKey    String?       @db.VarChar(500)
  status      ContentStatus @default(DRAFT)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, achievedAt])
}

model Event {
  id          String        @id @default(uuid()) @db.Uuid
  slug        String        @unique @db.VarChar(120)
  title       String        @db.VarChar(180)
  description String        @db.VarChar(3000)
  startsAt    DateTime
  endsAt      DateTime?
  location    String?       @db.VarChar(500)
  joinUrl     String?       @db.VarChar(1000)
  status      ContentStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, startsAt])
}

model Announcement {
  id          String        @id @default(uuid()) @db.Uuid
  title       String        @db.VarChar(180)
  body        String        @db.Text
  startsAt    DateTime?
  expiresAt   DateTime?
  status      ContentStatus @default(DRAFT)
  createdById String?       @db.Uuid
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, startsAt, expiresAt])
}

model Advertisement {
  id          String        @id @default(uuid()) @db.Uuid
  title       String        @db.VarChar(180)
  body        String        @db.VarChar(1000)
  mediaKey    String?       @db.VarChar(500)
  targetUrl   String?       @db.VarChar(1000)
  startsAt    DateTime?
  endsAt      DateTime?
  status      ContentStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, startsAt, endsAt])
}

model Notification {
  id        String            @id @default(uuid()) @db.Uuid
  userId    String            @db.Uuid
  kind      NotificationKind
  title     String            @db.VarChar(180)
  body      String            @db.VarChar(1200)
  href      String?           @db.VarChar(1000)
  readAt    DateTime?
  createdAt DateTime          @default(now())
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model EmailTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique @db.VarChar(80)
  subject   String   @db.VarChar(240)
  preheader String?  @db.VarChar(240)
  body      String   @db.Text
  variables String[]
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model EmailLog {
  id           String   @id @default(uuid()) @db.Uuid
  templateKey  String   @db.VarChar(80)
  recipient    String   @db.VarChar(254)
  provider      String   @db.VarChar(40)
  providerId    String?  @db.VarChar(255)
  status        String   @db.VarChar(32)
  errorCode     String?  @db.VarChar(100)
  createdAt     DateTime @default(now())

  @@index([recipient, createdAt])
  @@index([templateKey, status])
}

model AstraConversation {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String?        @db.Uuid
  title     String         @db.VarChar(180)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages  AstraMessage[]
  actions   AstraAction[]

  @@index([userId, updatedAt])
}

model AstraMessage {
  id             String           @id @default(uuid()) @db.Uuid
  conversationId String           @db.Uuid
  role           String           @db.VarChar(16)
  body           String           @db.VarChar(10000)
  createdAt      DateTime         @default(now())
  conversation   AstraConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model AstraAction {
  id             String           @id @default(uuid()) @db.Uuid
  conversationId String           @db.Uuid
  action         String           @db.VarChar(80)
  input          Json
  output         Json?
  confirmedAt    DateTime?
  executedAt     DateTime?
  result         String           @db.VarChar(32)
  createdAt      DateTime         @default(now())
  conversation   AstraConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String   @db.VarChar(120)
  entityType String   @db.VarChar(80)
  entityId   String?  @db.VarChar(100)
  result     String   @db.VarChar(24)
  details    Json?
  ipHash     String?  @db.VarChar(64)
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
}

model SiteStatistic {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(80)
  label       String   @db.VarChar(120)
  value       Decimal  @db.Decimal(14, 2)
  source       String   @db.VarChar(80)
  verifiedAt  DateTime?
  visible     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteSetting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique @db.VarChar(100)
  value     Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}
